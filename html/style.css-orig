/* Container for both gauges */
#dualGaugeContainer {
    position: absolute;
    bottom: 4%;
    left: 50%;
    transform: translateX(-50%);

    /* Match the supplied scuba gauge artwork (300 x 190). */
    width: 300px;
    height: 190px;

    /* Gauge housing/background. */
    background-image: url("scubaguage.png");
    background-repeat: no-repeat;
    background-position: center center;
    background-size: 300px 190px;

    display: none;
    pointer-events: none;
}

/* Oxygen gauge (left) */
#oxygenGauge {
    position: absolute;

    /* Positioned over the left opening in scubaguage.png */
    top: 55px;
    left: 37px;
    width: 90px;
    height: 90px;
}

/* Depth gauge (right) */
#depthGauge {
    position: absolute;

    /* Positioned over the right opening in scubaguage.png */
    top: 40px;
    right: 42px;
    width: 90px;
    height: 120px;
}

/* Shared circle styles */
svg {
    width: 100%;
    height: 100%;
}

circle {
    fill: none;
    stroke-width: 5;
    stroke-linecap: round;
}

.bg {
    stroke: rgba(255,255,255,0.15);
}

/* Oxygen ring */
.bar {
    stroke: #00cc66;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
    stroke-dasharray: 283;
    stroke-dashoffset: 0;
    transition: stroke 0.3s, stroke-dashoffset 0.2s;
}

/* Depth ring (static color) */
.depthRing {
    stroke: #66ccff;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
    stroke-dasharray: 283;
    stroke-dashoffset: 0;
}

/* Oxygen label */
#oxygenLabel {
    position: absolute;
    top: 35%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: white;
    font-size: 18px;
    font-weight: bold;
    text-shadow: 0 0 8px black;
}

/* Oxygen percentage */
#oxygenText {
    position: absolute;
    top: 65%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: white;
    font-size: 18px;
    font-weight: bold;
    text-shadow: 0 0 8px black;
}

/* Depth label */
#depthLabel {
    position: absolute;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: white;
    font-size: 18px;
    font-weight: bold;
    text-shadow: 0 0 8px black;
}

/* Depth value (digital) */
#depthText {
    position: absolute;
    top: 60%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #66ccff;
    font-size: 20px;
    font-weight: bold;
    text-shadow: 0 0 8px black;
}
